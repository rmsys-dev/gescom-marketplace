# URL base da API Gescom (sem barra final). A loja fala com a API via Route Handlers.
# Ex.: API na porta 3000 e Next na 3001.
GESCOM_API_URL=http://localhost:3000

# UUID da empresa (loja) no Gescom.
GESCOM_ENTERPRISE_ID=00000000-0000-0000-0000-000000000000

# Timeout por pedido HTTP (ms)
API_TIMEOUT_MS=10000

# Forçar Secure nos cookies de sessão (ex.: dev com HTTPS)
# AUTH_COOKIE_SECURE=true

# Na API Gescom: CORS_ORIGINS deve listar a origem exata desta app (ex.: http://localhost:3001).
# O browser só chama as rotas /api/conta/* desta loja; a loja chama a API no servidor.
